{
  "//": "JSON's static array supports Helm 2 set_sensitive blocks and Helm 3 list attributes. Keep credentials out of ordinary values so Helm also redacts metadata.",
  "resource": {
    "helm_release": {
      "this": {
        "for_each": "${var.install.enabled ? { renovate = true } : {}}",
        "name": "${var.install.release_name}",
        "namespace": "${var.install.namespace}",
        "create_namespace": "${var.install.create_namespace}",
        "repository": "oci://ghcr.io/renovatebot/charts",
        "chart": "renovate",
        "version": "${var.install.chart_version}",
        "timeout": 300,
        "wait": true,
        "atomic": true,
        "values": ["${yamlencode(local.helm_values)}"],
        "set_sensitive": [
          {
            "name": "secrets.RENOVATE_TOKEN",
            "value": "${var.renovate_token == null ? \"\" : var.renovate_token}",
            "type": "string"
          }
        ],
        "lifecycle": {
          "precondition": [
            {
              "condition": "${(var.renovate_token != null) != (trimspace(var.install.existing_secret) != \"\")}",
              "error_message": "Enabled installation requires exactly one of renovate_token or install.existing_secret."
            },
            {
              "condition": "${local.cron_valid}",
              "error_message": "install.schedule must be numeric five-field cron with valid ranges, lists and positive steps."
            },
            {
              "condition": "${length(var.repositories) > 0}",
              "error_message": "Enabled installation requires at least one explicit repository path."
            }
          ]
        }
      }
    }
  }
}
